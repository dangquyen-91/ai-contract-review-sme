NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Atlas Vector Search requires Atlas, not local mongod)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_contract_review

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# LLM provider keys (filled in when AI modules are scaffolded)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Object storage (MinIO/S3) - filled in when upload module is scaffolded
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=contracts
