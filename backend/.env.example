NODE_ENV=development
PORT=4000
# Required for counting DOCX pages before review. Docker includes LibreOffice.
# Windows default: C:\Program Files\LibreOffice\program\soffice.exe; Linux: soffice
# LIBREOFFICE_PATH=soffice
# Giá rà soát riêng cho tài khoản cá nhân, mỗi 5 trang (làm tròn lên).
PERSONAL_REVIEW_PRICE_PER_UNIT=10000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_contract_review
# Optional resolver override for MongoDB SRV/TXT lookup issues (e.g. 8.8.8.8,8.8.4.4).
# Leave empty to use system DNS. Applies to Node dns.resolve* calls in this process.
DNS_SERVERS=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3000

DATA_ENCRYPTION_KEY=

# Frontend landing page that reads ?token=... (frontend implemented separately).
INVITATION_ACCEPT_URL=http://localhost:3000/loi-moi
# Brevo HTTP API (API key, not SMTP key). Verify the sender in Brevo first.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AI Contract Review
GOOGLE_CLIENT_ID=

# payOS HTTP API. Keep credentials on the backend only.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
PAYOS_CANCEL_URL=http://localhost:3000/thanh-toan/huy

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LEGAL_EMBED_TOKENS_PER_MINUTE=30000
LEGAL_EMBED_REQUESTS_PER_MINUTE=100

OCR_WORKERS=2

REDIS_URL=redis://localhost:6379
START_WORKERS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
