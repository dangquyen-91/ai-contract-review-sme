NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_contract_review

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3000

# Frontend landing page that reads ?token=... (frontend implemented separately).
INVITATION_ACCEPT_URL=http://localhost:3000/loi-moi
# SMTP accepts mail for delivery; production should use a verified sender.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Contract Review <no-reply@example.com>

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
