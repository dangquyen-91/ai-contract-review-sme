        <mxCell id="e1" value="user uploads&lt;br&gt;contract file" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="uploaded"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
